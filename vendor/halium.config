CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
# SELinux and AppArmor are exclusive on this kernel. Ubuntu Touch confines apps
# with AppArmor, so make it the default LSM (boot with apparmor=1 security=apparmor).
CONFIG_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf"
CONFIG_BT_HCIVHCI=y
